<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.CognitoIdentityProvider" Version="3.7.405" />
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="dbup-postgresql" Version="5.0.40" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.2.1" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Stripe.net" Version="52.1.0" />
  </ItemGroup>

  <!-- Ordered SQL migrations are embedded so DbUp can apply them from the published assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Migrations\**\*.sql" />
  </ItemGroup>

  <!-- The unit suite reaches internal seams (e.g. the uncapped MeteringService.FlushLeaseAsync primitive
       that production paths must not call directly — task #60 keeps the shared TTL cap as the single
       source of truth). Test-only, not shipped externally. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Wisper.Api.Tests" />
  </ItemGroup>

</Project>
